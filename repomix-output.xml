    }
    if (*respuesta == MSG_INTERRUPT) {
        free(respuesta);
        log_info(logger_cpu,"## Interrupcion recibida");
        int size_interrupcion = 0;
        interrupcion_entrante = recibir_mensaje(fd_ks, &size_interrupcion);

        if (interrupcion_entrante == NULL) {
