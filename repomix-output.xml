                }  

            log_debug(logger_cpu, "evalua EXIT");
            if (romper_ciclo == true) {
                log_info(logger_cpu, "Concluyo proceso %d con EXIT", pid);
                free(instruccion);
                destruir_contexto(contexto);
                break;
            }
            free(instruccion);
        }
    destruir_mapa_memory_sticks(mapa);
    }
}
